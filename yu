<!DOCTYPE html>
<html lang="vi">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Phim360 Pro Max</title>

<style>
body{margin:0;font-family:Arial;background:#0f0f0f;color:white;}
header{display:flex;justify-content:space-between;align-items:center;padding:15px;background:#000;position:sticky;top:0;}
.logo{color:red;font-size:22px;font-weight:bold;}
input{padding:8px;border:none;border-radius:5px;width:200px;}

.banner{
    padding:30px;
    background:linear-gradient(to right,#000,#222);
    text-align:center;
}

.container{
    display:grid;
    grid-template-columns:repeat(auto-fit,minmax(160px,1fr));
    gap:12px;
    padding:15px;
}

.movie{
    background:#222;
    border-radius:10px;
    overflow:hidden;
    cursor:pointer;
    transition:0.3s;
}

.movie:hover{transform:scale(1.05);}

.movie img{width:100%;height:240px;object-fit:cover;}

.title{padding:8px;font-size:14px;}

#detail{
    display:none;
    position:fixed;
    top:0;left:0;
    width:100%;height:100%;
    background:black;
    z-index:999;
}

#detail iframe{
    width:100%;
    height:100%;
}

.close{
    position:absolute;
    top:10px;
    right:10px;
    background:red;
    border:none;
    padding:10px;
    color:white;
    cursor:pointer;
}
</style>
</head>

<body>

<header>
<div class="logo">🎬 PHIM360 PRO MAX</div>
<input id="search" placeholder="Tìm phim...">
</header>

<div class="banner">
🔥 Kho phim tự động – cập nhật mỗi ngày – xem miễn phí
</div>

<div class="container" id="list"></div>

<div id="detail">
<button class="close" onclick="closeDetail()">X</button>
<iframe id="frame"></iframe>
</div>

<script>

const API = "YOUR_API_KEY";

const URL = `https://api.themoviedb.org/3/trending/movie/day?api_key=${API}`;

let dataStore = [];

fetch(URL)
.then(res=>res.json())
.then(data=>{
    dataStore = data.results;
    render(dataStore);
});

function render(list){
    let html = "";
    list.forEach(m=>{
        html += `
        <div class="movie" onclick="openMovie('${m.id}')">
            <img src="https://image.tmdb.org/t/p/w500${m.poster_path}">
            <div class="title">${m.title}</div>
        </div>
        `;
    });
    document.getElementById("list").innerHTML = html;
}

function openMovie(id){
    // dùng trailer YouTube từ TMDB
    fetch(`https://api.themoviedb.org/3/movie/${id}/videos?api_key=${API}`)
    .then(r=>r.json())
    .then(v=>{
        let key = v.results[0]?.key;
        if(key){
            document.getElementById("frame").src =
            `https://www.youtube.com/embed/${key}`;
            document.getElementById("detail").style.display="block";
        }
    });
}

function closeDetail(){
    document.getElementById("detail").style.display="none";
    document.getElementById("frame").src="";
}

/* SEARCH */
document.getElementById("search").addEventListener("input",function(){
    let val = this.value.toLowerCase();
    render(dataStore.filter(m=>m.title.toLowerCase().includes(val)));
});

</script>

</body>
</html>
