<!DOCTYPE html>
<html lang="vi">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Phim360</title>

<style>
body {
    margin: 0;
    font-family: Arial;
    background: #0f0f0f;
    color: white;
}

/* HEADER */
header {
    background: #141414;
    padding: 15px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    position: sticky;
    top: 0;
}

.logo {
    color: red;
    font-size: 24px;
    font-weight: bold;
}

/* SEARCH */
input {
    padding: 8px;
    border-radius: 5px;
    border: none;
    width: 200px;
}

/* CATEGORY */
.menu {
    display: flex;
    gap: 10px;
    padding: 10px;
    background: #1c1c1c;
}

.menu button {
    background: #333;
    color: white;
    border: none;
    padding: 8px 12px;
    cursor: pointer;
    border-radius: 5px;
}

.menu button:hover {
    background: red;
}

/* MOVIE GRID */
.container {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 15px;
    padding: 15px;
}

.movie {
    background: #222;
    padding: 10px;
    border-radius: 10px;
    cursor: pointer;
    transition: 0.3s;
}

.movie:hover {
    transform: scale(1.05);
    background: #333;
}

.movie img {
    width: 100%;
    border-radius: 10px;
}

.title {
    margin-top: 8px;
    font-size: 14px;
}

/* PLAYER */
#player {
    display: none;
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: black;
    z-index: 999;
}

#player iframe {
    width: 100%;
    height: 100%;
}

.close {
    position: absolute;
    top: 10px;
    right: 10px;
    background: red;
    color: white;
    border: none;
    padding: 10px;
    cursor: pointer;
}
</style>
</head>

<body>

<header>
<div class="logo">🎬 PHIM360</div>
<input type="text" id="search" placeholder="Tìm phim...">
</header>

<div class="menu">
<button onclick="filter('all')">Tất cả</button>
<button onclick="filter('hanhdong')">Hành động</button>
<button onclick="filter('tinhcam')">Tình cảm</button>
<button onclick="filter('kinhdi')">Kinh dị</button>
</div>

<div class="container" id="movies">

<div class="movie hanhdong" onclick="play('https://www.youtube.com/embed/dQw4w9WgXcQ')">
<img src="https://i.imgur.com/8Km9tLL.jpg">
<div class="title">Phim Hành Động 1</div>
</div>

<div class="movie tinhcam" onclick="play('https://www.youtube.com/embed/dQw4w9WgXcQ')">
<img src="https://i.imgur.com/1bX5QH6.jpg">
<div class="title">Tình Yêu Không Nói Dối</div>
</div>

<div class="movie kinhdi" onclick="play('https://www.youtube.com/embed/dQw4w9WgXcQ')">
<img src="https://i.imgur.com/9yG1xQk.jpg">
<div class="title">Trường Học Ma Ám</div>
</div>

</div>

<!-- PLAYER -->
<div id="player">
<button class="close" onclick="closePlayer()">X</button>
<iframe id="video" src=""></iframe>
</div>

<script>
function play(url){
    document.getElementById("player").style.display = "block";
    document.getElementById("video").src = url;
}

function closePlayer(){
    document.getElementById("player").style.display = "none";
    document.getElementById("video").src = "";
}

function filter(type){
    let movies = document.getElementsByClassName("movie");
    for(let m of movies){
        if(type === "all"){
            m.style.display = "block";
        } else {
            m.style.display = m.classList.contains(type) ? "block" : "none";
        }
    }
}

document.getElementById("search").addEventListener("input", function(){
    let val = this.value.toLowerCase();
    let movies = document.getElementsByClassName("movie");

    for(let m of movies){
        let title = m.innerText.toLowerCase();
        m.style.display = title.includes(val) ? "block" : "none";
    }
});
</script>

</body>
</html>
