<!DOCTYPE html>
<html lang="vi">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Phim360</title>

<style>
body{
    margin:0;
    font-family:Arial;
    background:#0f0f0f;
    color:white;
}

/* HEADER */
header{
    display:flex;
    justify-content:space-between;
    align-items:center;
    padding:15px;
    background:#000;
    position:sticky;
    top:0;
}

.logo{
    color:red;
    font-size:22px;
    font-weight:bold;
}

/* SEARCH */
input{
    padding:8px;
    border-radius:5px;
    border:none;
    width:200px;
}

/* DESCRIPTION */
.desc{
    text-align:center;
    padding:15px;
    color:#bbb;
}

/* MENU */
.menu{
    display:flex;
    gap:10px;
    padding:10px;
    justify-content:center;
    background:#141414;
}

.menu button{
    padding:8px 12px;
    border:none;
    border-radius:5px;
    background:#333;
    color:white;
    cursor:pointer;
}

.menu button:hover{
    background:red;
}

/* MOVIES */
.container{
    display:grid;
    grid-template-columns:repeat(auto-fit,minmax(160px,1fr));
    gap:12px;
    padding:15px;
}

.movie{
    background:#222;
    border-radius:10px;
    overflow:hidden;
    cursor:pointer;
    transition:0.3s;
}

.movie:hover{
    transform:scale(1.05);
}

.movie img{
    width:100%;
    height:220px;
    object-fit:cover;
}

.movie-title{
    padding:8px;
    font-size:14px;
}

/* PLAYER */
#player{
    display:none;
    position:fixed;
    top:0;
    left:0;
    width:100%;
    height:100%;
    background:black;
    z-index:999;
}

#player iframe{
    width:100%;
    height:100%;
}

.close{
    position:absolute;
    top:10px;
    right:10px;
    background:red;
    border:none;
    padding:10px;
    color:white;
    cursor:pointer;
}
</style>
</head>

<body>

<header>
<div class="logo">🎬 PHIM360</div>
<input id="search" placeholder="Tìm phim...">
</header>

<div class="desc">
Phim360 – thế giới phim trong một cú click. Xem phim nhanh, mượt, cập nhật mỗi ngày.
</div>

<div class="menu">
<button onclick="filter('all')">Tất cả</button>
<button onclick="filter('action')">Hành động</button>
<button onclick="filter('love')">Tình cảm</button>
<button onclick="filter('horror')">Kinh dị</button>
</div>

<div class="container" id="list"></div>

<!-- PLAYER -->
<div id="player">
<button class="close" onclick="closePlayer()">X</button>
<iframe id="video" src=""></iframe>
</div>

<script>

/* 🎬 DANH SÁCH PHIM MẪU */
const movies = [
{
title:"Phim Hành Động 1",
type:"action",
img:"https://i.imgur.com/8Km9tLL.jpg",
video:"https://www.youtube.com/embed/dQw4w9WgXcQ"
},
{
title:"Tình Yêu Không Nói Dối",
type:"love",
img:"https://i.imgur.com/1bX5QH6.jpg",
video:"https://www.youtube.com/embed/dQw4w9WgXcQ"
},
{
title:"Trường Học Ma Ám",
type:"horror",
img:"https://i.imgur.com/9yG1xQk.jpg",
video:"https://www.youtube.com/embed/dQw4w9WgXcQ"
},
{
title:"Kẻ Không Mặt",
type:"horror",
img:"https://i.imgur.com/6yU9H7k.jpg",
video:"https://www.youtube.com/embed/dQw4w9WgXcQ"
},
{
title:"Chiến Binh Bóng Tối",
type:"action",
img:"https://i.imgur.com/2yaf2wb.jpg",
video:"https://www.youtube.com/embed/dQw4w9WgXcQ"
}
];

function render(list){
    let html = "";
    list.forEach(m=>{
        html += `
        <div class="movie" onclick="play('${m.video}')">
            <img src="${m.img}">
            <div class="movie-title">${m.title}</div>
        </div>
        `;
    });
    document.getElementById("list").innerHTML = html;
}

render(movies);

/* FILTER */
function filter(type){
    if(type==="all") return render(movies);
    render(movies.filter(m=>m.type===type));
}

/* SEARCH */
document.getElementById("search").addEventListener("input",function(){
    let val = this.value.toLowerCase();
    render(movies.filter(m=>m.title.toLowerCase().includes(val)));
});

/* PLAYER */
function play(url){
    document.getElementById("player").style.display="block";
    document.getElementById("video").src=url;
}

function closePlayer(){
    document.getElementById("player").style.display="none";
    document.getElementById("video").src="";
}

</script>

</body>
</html>
